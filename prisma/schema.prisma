generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String            @id @default(uuid()) @db.Uuid
  auth0Sub             String            @unique @map("auth0_sub")
  email                String            @unique
  name                 String?
  picture              String?
  roles                String[]          @default(["user"])
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  lastLoginAt          DateTime?         @map("last_login_at")
  accounts             Account[]
  apiKeys              ApiKey[]
  sessions             Session[]
  preferences          UserPreference?
  billingUsage         BillingUsage?
  onboardingCompleted        Boolean              @default(false) @map("onboarding_completed")
  userIntent                 String?              @map("user_intent")
  dashboardPreset            String?              @map("dashboard_preset")
  subscriptionTier           String               @default("free") @map("subscription_tier")
  subscriptionStatus         String?              @default("active") @map("subscription_status")
  subscriptionEndsAt         DateTime?            @map("subscription_ends_at")
  monthlyRequestCount        Int                  @default(0) @map("monthly_request_count")
  monthlyRequestResetAt      DateTime?            @map("monthly_request_reset_at")
  storageUsedBytes           BigInt               @default(0) @map("storage_used_bytes")

  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshToken      String    @unique @map("refresh_token")
  expiresAt         DateTime  @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  revokedAt         DateTime? @map("revoked_at")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  deviceInfo        Json?     @map("device_info")
  lastActiveAt      DateTime? @map("last_active_at")
  isActive          Boolean   @default(true) @map("is_active")
  deviceFingerprint String?   @map("device_fingerprint") @db.VarChar(255)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([isActive])
  @@index([deviceFingerprint])
  @@map("sessions")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  keyHash    String    @unique @map("key_hash")
  keyPrefix  String    @map("key_prefix")
  scopes     String[]  @default(["read"])
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  rateLimit  Int       @default(1000) @map("rate_limit")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

model UserPreference {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  theme               String   @default("system")
  language            String   @default("en")
  timezone            String   @default("UTC")
  defaultModel        String   @default("gpt-4") @map("default_model")
  embeddingModel      String   @default("gemini-embedding-2") @map("embedding_model")
  enableNotifications Boolean  @default(true) @map("enable_notifications")
  emailDigest         String   @default("weekly") @map("email_digest")
  customSettings      Json?    @default("{}") @map("custom_settings")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model BillingUsage {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  subscriptionTier   String   @default("free") @map("subscription_tier")
  reposCount         Int      @default(0) @map("repos_count")
  docsCount          Int      @default(0) @map("docs_count")
  lastUpdated        DateTime @updatedAt @map("last_updated")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("billing_usage")
}

// These tables are managed by the Rust processing services (doc-uni-proc, repo-uni-proc)
// and are included here for reference only. They are not managed by Prisma migrations.
model file_metadata {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_id    String    @db.VarChar(255)
  filename     String    @db.VarChar(255)
  file_type    String    @db.VarChar(50)
  language     String?   @db.VarChar(50)
  size_bytes   Int?
  line_count   Int?
  processed_at DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([source_id, filename])
  @@index([source_id], map: "idx_file_metadata_source_id")
}


model chunk_snapshot {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_id       String    @db.VarChar(255)
  filename        String    @db.VarChar(255)
  start_byte      BigInt    @db.BigInt
  end_byte        BigInt    @db.BigInt
  chunk_key       String    @db.VarChar(255)
  chunk_hash      String    @db.VarChar(255)
  commit_id       String?   @db.VarChar(255)
  embedding_model String    @db.VarChar(100)
  last_indexed_at DateTime? @db.Timestamptz(6)
  tombstone       Boolean   @default(false)

  @@index([source_id, filename], map: "idx_chunk_snapshot_source_file")
  @@index([chunk_key], map: "idx_chunk_snapshot_key")
}




